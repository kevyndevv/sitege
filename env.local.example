# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto
# Supabase (Project Settings → API). Nunca coloque valores reais neste exemplo.

# URL do projeto (sem /rest/v1 no final)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública: "anon" (formato eyJ...) ou "publishable" (formato sb_publishable_...).
# Ela é pública por natureza: quem protege os dados são as políticas RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Opcional: endereço público do site (usado no link de "esqueci minha senha").
# NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# NUNCA adicione aqui a chave "service_role"/"secret": este projeto não precisa dela.
